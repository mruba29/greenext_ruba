# ==============================================================================
# GreenNext Digital Infrastructure — Environment Configuration Template
# Copy this file to .env.local for local development or configure in Vercel
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Automated Lead Notification Email Configuration
# ------------------------------------------------------------------------------
# Recipient administrator email address for new lead notifications
ADMIN_NOTIFICATION_EMAIL=ruba.int2027g3@gmail.com

# Verified sender identity (Name & domain or email)
EMAIL_FROM=GreenNext Leads <leads@greennext.in>

# Verified business WhatsApp number (Country code + phone without + or spaces)
WHATSAPP_PHONE=919876543210

# Transactional Email Service Provider (Provide either Resend or SendGrid)
# Option A: Resend (Recommended) — https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Option B: SendGrid — https://app.sendgrid.com/settings/api_keys
# SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# ------------------------------------------------------------------------------
# 2. Google Sheets & Google Apps Script Integration
# ------------------------------------------------------------------------------
# Google Apps Script Web App Deployment URL (Unified Web App)
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbzoSXPulFt49lQ1ibWJX2CFNw7iiuT4YBAShuiEcckEovty7FauYnspHCuHQmSqFZk/exec

# Target Google Sheets Workbook URL (for email notification references)
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/14ciH1aNzWIJHJkQ5rYCdrEhci3KYMjrTSeY3QMaerVI/edit

# ------------------------------------------------------------------------------
# 3. Atlassian Jira Cloud Integration
# ------------------------------------------------------------------------------
# Jira Cloud Instance Base URL
JIRA_BASE_URL=https://trustworkz.atlassian.net

# Verified Atlassian account email
JIRA_EMAIL=ruba.int2027g3@gmail.com

# Jira API Token generated from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_jira_api_token_here

# Target Jira Project Key (e.g., DI for Digital Infrastructure)
JIRA_PROJECT_KEY=DI

# Assignee Account ID for incoming lead tasks
JIRA_ASSIGNEE_ACCOUNT_ID=712020:6d7507eb-bb5e-4ef5-b65a-0d65b169527e

# Active Sprint ID (Optional: adds parent task to the ongoing sprint)
JIRA_ACTIVE_SPRINT_ID=35

# ------------------------------------------------------------------------------
# 4. Airtable Lead Database Integration
# ------------------------------------------------------------------------------
# Airtable Personal Access Token (PAT) with data.records:read and data.records:write scope
# Generate at: https://airtable.com/create/tokens
AIRTABLE_PAT=

# Target Base ID (GreenNext Lead Base)
AIRTABLE_BASE_ID=appnkJABVWFGwX7Lv

# Target Leads Table ID
AIRTABLE_LEADS_TABLE_ID=tblYi5BguStHsPtA4

# Optional: Preferred View ID (default: viwDw74iTVtxylb60)
AIRTABLE_VIEW_ID=viwDw74iTVtxylb60

