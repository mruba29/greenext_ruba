{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/analytics", "destination": "/analytics.html" },
    { "source": "/dashboard", "destination": "/analytics.html" },
    { "source": "/templates", "destination": "/templates.html" },
    { "source": "/capabilities", "destination": "/capabilities/index.html" },
    { "source": "/industries", "destination": "/industries/index.html" },
    { "source": "/solutions", "destination": "/solutions/index.html" },
    { "source": "/locations", "destination": "/locations/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
