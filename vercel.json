{
  "version": 2,
  "builds": [
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/capabilities",   "dest": "/capabilities/index.html" },
    { "src": "/industries",     "dest": "/industries/index.html" },
    { "src": "/solutions",      "dest": "/solutions/index.html" },
    { "src": "/locations",      "dest": "/locations/index.html" },
    { "src": "/(.*)",           "dest": "/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",        "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
